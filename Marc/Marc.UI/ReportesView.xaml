<UserControl x:Class="Marc.UI.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Margin="24">
        <StackPanel>

            <TextBlock Text="Puntaje promedio por tema"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker x:Name="FechaDesde" Width="140" Margin="0,0,16,0" />

                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker x:Name="FechaHasta" Width="140" Margin="0,0,16,0" />

                <Button Content="Calcular" Padding="16,4" Click="BtnCalcularPromedio_Click" />
            </StackPanel>

            <DataGrid x:Name="GrillaPromedioPorTema"
                      Height="180"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Margin="0,0,0,32" />

            <TextBlock Text="Vocabulario mas repetido"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Mostrar top:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TxtTopN" Width="50" Text="10" Margin="0,0,16,0" />

                <Button Content="Calcular" Padding="16,4" Click="BtnCalcularVocabulario_Click" />
            </StackPanel>

            <DataGrid x:Name="GrillaVocabulario"
                      Height="220"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
<UserControl x:Class="Marc.UI.VocabularioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top"
                   Text="Mi vocabulario"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <ScrollViewer>
            <ItemsControl x:Name="ListaVocabulario">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,12,12"
                                Width="220">
                            <StackPanel>
                                <TextBlock Text="{Binding Palabra}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Significado}"
                                           Foreground="#AAAAAA"
                                           FontSize="13"
                                           Margin="0,6,0,10"
                                           TextWrapping="Wrap" />
                                <TextBlock Foreground="#4CAF50"
                                           FontSize="12">
                                    <Run Text="Repetida " />
                                    <Run Text="{Binding VecesRepetida}" />
                                    <Run Text=" veces" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
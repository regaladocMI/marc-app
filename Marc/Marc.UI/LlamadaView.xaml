<UserControl x:Class="Marc.UI.LlamadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#121212">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado: nombre del tema -->
        <TextBlock x:Name="TxtNombreTema"
                   Grid.Row="0"
                   Text="Conversacion libre"
                   Foreground="#CCCCCC"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,24,0,0" />

        <!-- Zona central: burbuja de mensaje -->
        <StackPanel Grid.Row="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            MaxWidth="500"
            Margin="24,0">

            <!-- Burbuja del usuario -->
            <Border x:Name="BurbujaUsuario"
            Background="#2A3F5F"
            CornerRadius="16"
            Padding="20"
            HorizontalAlignment="Right"
            MaxWidth="420"
            Margin="0,0,0,16"
            Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Vos" Foreground="#AABBDD" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock x:Name="TxtMensajeUsuario"
                       Text=""
                       Foreground="White"
                       FontSize="18"
                       TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Burbuja de Ada -->
            <Border x:Name="BurbujaAda"
            Background="#1E1E1E"
            CornerRadius="16"
            Padding="20"
            HorizontalAlignment="Left"
            MaxWidth="420">
                <StackPanel>
                    <TextBlock Text="Ada" Foreground="#888888" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock x:Name="TxtMensajeAda"
                       Text="Presiona Hablar para empezar."
                       Foreground="White"
                       FontSize="18"
                       TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtPuntaje"
               Foreground="#4CAF50"
               FontSize="14"
               FontWeight="Bold"
               HorizontalAlignment="Right"
               Margin="0,8,4,0"
               Visibility="Collapsed" />
        </StackPanel>
        <!-- Barra inferior -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtEstado"
                           Grid.Column="0"
                           Text="Presiona el microfono para hablar"
                           Foreground="#AAAAAA"
                           VerticalAlignment="Center" />

                <Button x:Name="BtnColgar"
                        Grid.Column="1"
                        Content="Colgar"
                        Background="#B00020"
                        Foreground="White"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="BtnColgar_Click" />

                <Button x:Name="BtnAjustes"
                        Grid.Column="2"
                        Content="Ajustes"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Click="BtnAjustes_Click" />

                <Button x:Name="BtnMicrofono"
                        Grid.Column="3"
                        Content="Hablar"
                        Background="#4CAF50"
                        Foreground="White"
                        Padding="16,8"
                        Click="BtnMicrofono_Click" />
            </Grid>
        </Border>
    </Grid>

</UserControl>
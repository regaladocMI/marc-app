<UserControl x:Class="Marc.UI.SeleccionTemaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="24">
        <TextBlock Text="¿Sobre que tema queres practicar hoy?"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <ListBox x:Name="ListaTemas"
                 DisplayMemberPath="Nombre"
                 SelectionChanged="ListaTemas_SelectionChanged"
                 MaxHeight="500" />
    </StackPanel>

</UserControl>
<Window x:Class="Marc.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Marc.UI"
        mc:Ignorable="d"
        Title="MARC - Tutor de ingles" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1E1E1E" Padding="16">
            <DockPanel>
                <TextBlock Text="MARC" FontSize="22" FontWeight="Bold" Foreground="White" />
                <Button Content="Temas" HorizontalAlignment="Right" Padding="12,4" Click="BtnTemas_Click" />
                <Button Content="Historial" HorizontalAlignment="Right" Padding="12,4" Margin="0,0,8,0" Click="BtnHistorial_Click" />
                <Button Content="Reportes" HorizontalAlignment="Right" Padding="12,4" Margin="0,0,8,0" Click="BtnReportes_Click" />
                <Button Content="Vocabulario" HorizontalAlignment="Right" Padding="12,4" Margin="0,0,8,0" Click="BtnVocabulario_Click" />
                <Button Content="Practicar" HorizontalAlignment="Right" Padding="12,4" Margin="0,0,8,0" Click="BtnPracticar_Click" />
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContenedorPrincipal"
                        Grid.Row="1"
                        Margin="16" />

    </Grid>
</Window>

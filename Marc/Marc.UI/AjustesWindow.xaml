<Window x:Class="Marc.UI.AjustesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes"
        Width="380" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <StackPanel Margin="20">
        <TextBlock Text="Velocidad del habla" Foreground="White" FontWeight="Bold" />
        <TextBlock x:Name="TxtVelocidad" Text="1.0x" Foreground="#AAAAAA" Margin="0,4,0,4" />
        <Slider x:Name="SliderVelocidad"
                Minimum="0.5" Maximum="1.5" Value="1.0"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                ValueChanged="SliderVelocidad_ValueChanged" />

        <TextBlock Text="Paciencia del tutor (segundos de silencio)" Foreground="White" FontWeight="Bold" Margin="0,20,0,0" />
        <TextBlock x:Name="TxtPaciencia" Text="2s" Foreground="#AAAAAA" Margin="0,4,0,4" />
        <Slider x:Name="SliderPaciencia"
                Minimum="1" Maximum="5" Value="2"
                TickFrequency="1" IsSnapToTickEnabled="True"
                ValueChanged="SliderPaciencia_ValueChanged" />

        <Button Content="Cerrar" Margin="0,24,0,0" Padding="0,8" Click="BtnCerrar_Click" />
    </StackPanel>

</Window>